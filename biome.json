{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**/packages/**/*/src/**/*.ts",
			"**/packages/**/*/*.ts",
			"**/tooling/**/*.ts",
			"**/apps/**/*.ts",
			"**/apps/**/*.mjs",
			"**/apps/**/*.json",
			"**/*.ts",
			"**/*.json",
			"!**/.turbo",
			"!**/.astro",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error"
			},
			"style": {
				"useConst": "error"
			}
		}
	}
}
