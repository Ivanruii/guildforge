{
	"name": "@discord-manager/monorepo",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.9.0",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"workspaces": ["packages/*", "tooling/*"],
	"scripts": {
		"build": "turbo build",
		"test": "turbo test",
		"test:watch": "turbo test:watch",
		"test:coverage": "turbo test:coverage",
		"typecheck": "turbo typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"inspect": "npm run build --workspace=packages/mcp && npx @modelcontextprotocol/inspector node packages/mcp/dist/index.mjs",
		"prepare": "husky || \"No need to install husky\""
	},
	"lint-staged": {
		"*.{js,ts,json}": [
			"biome check --write --no-errors-on-unmatched",
			"biome format --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@modelcontextprotocol/inspector": "^0.21.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"turbo": "^2.9.6"
	}
}
