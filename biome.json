{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"files": {
		"include": [
			"packages/*/src/**/*.ts",
			"packages/*/*.ts",
			"tooling/**/*.ts",
			"apps/**/*.ts",
			"apps/**/*.mjs",
			"apps/**/*.json",
			"*.ts",
			"*.json"
		],
		"ignore": [".turbo", ".astro", "node_modules", "dist", "coverage"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error"
			},
			"style": {
				"useConst": "error"
			}
		}
	}
}
