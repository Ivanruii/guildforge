{
	"name": "@discord-manager/mcp",
	"version": "1.0.0",
	"description": "MCP Server to manage Discord channels, categories, roles and permissions",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#*": "./src/*"
	},
	"files": [
		"dist"
	],
	"bin": {
		"discord-manager-mcp": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.mjs"
	},
	"keywords": [
		"mcp",
		"discord",
		"bot",
		"manager"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/discord-manager/discord-manager-mcp.git",
		"directory": "packages/mcp"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"discord.js": "^14.26.4",
		"dotenv": "^17.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@discord-manager/tsdown-config": "workspace:*",
		"@discord-manager/typescript-config": "workspace:*",
		"@discord-manager/vitest-config": "workspace:*",
		"@types/node": "^25.9.1",
		"tsdown": "^0.22.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
