{
	"name": "@discord-manager/monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.10.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"scripts": {
		"build": "turbo build",
		"test": "turbo test",
		"test:watch": "turbo test:watch",
		"test:coverage": "turbo test:coverage",
		"typecheck": "turbo typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"inspect": "pnpm turbo build && pnpm dlx @modelcontextprotocol/inspector node packages/mcp/dist/index.mjs",
		"changeset": "changeset",
		"prepare": "husky || echo 'No need to install husky'"
	},
	"lint-staged": {
		"*.{js,ts,json}": [
			"biome check --write --no-errors-on-unmatched",
			"biome format --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@changesets/cli": "^2.31.0",
		"@modelcontextprotocol/inspector": "^0.21.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"turbo": "^2.9.16"
	}
}
